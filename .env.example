# =============================================================================
#  Ek Sathi Backend - Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git - it is listed in .gitignore.
#  App runs 100% localhost: no Firebase, no Cloudinary.
#  Chat data + uploaded files persist to ./data/ (gitignored).
# =============================================================================

# --- OpenRouter API Keys (LLM) -----------------------------------------------
# Add up to 11 keys. The service rotates through them round-robin to spread
# load and avoid rate-limits. Leave unused slots blank (KEY3= is fine).
# BOB_API_KEY / CENTER_API_KEY pin a key to a fixed role; any configured key
# without a role is a replacement (swap-in when a role key exhausts).
OPENROUTER_API_KEY1=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_API_KEY2=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_API_KEY3=
OPENROUTER_API_KEY4=
OPENROUTER_API_KEY5=
OPENROUTER_API_KEY6=
OPENROUTER_API_KEY7=
OPENROUTER_API_KEY8=
OPENROUTER_API_KEY9=
OPENROUTER_API_KEY10=
OPENROUTER_API_KEY11=

# Per-key role assignment (optional but recommended).
BOB_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
CENTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx2

# --- Model Configuration ------------------------------------------------------
# Which model handles each role. See src/services/llmService.js -> MODEL_ROLES.
# Models are auto-selected at call time by resolveModel() (vision support /
# context size / cost tier) and shift automatically if the model can't do the
# job (e.g. images on a text-only model, or an oversized prompt).
WRITER_MODEL=google/gemini-2.5-flash-lite
REVIEW_MODEL=google/gemini-2.5-flash
AUDITOR_MODEL=google/gemini-2.5-flash
VISION_MODEL=google/gemini-2.5-flash-lite
CHEAP_MODEL=google/gemini-2.5-flash-lite

# --- GitHub Repo Self-Read ----------------------------------------------------
# Optional. Lets the app read PRIVATE repositories and raises the GitHub API
# rate limit (anonymous is 60 requests/hour). Public repos work without it.
GITHUB_TOKEN=

# --- Generation Settings ------------------------------------------------------
TEMPERATURE=0.2
MAX_TOKENS=2500
MAX_TOKENS_PER_KEY=150000

# --- Access Control (local only) ----------------------------------------------
# requireAuth always maps to this single local user. No Firebase verify.
SHARED_ADMIN_ID=nikhil_master_workspace

# --- Server -------------------------------------------------------------------
PORT=3000
ALLOWED_ORIGIN=http://localhost:3000

# --- Live Data (weather / news / markets) --------------------------------------
# Free, key-less APIs (Open-Meteo, public RSS feeds, Yahoo Finance).
# DEFAULT_CITY is used for weather in the daily briefing and proactive greeting.
DEFAULT_CITY=New Delhi
DEFAULT_LAT=
DEFAULT_LON=