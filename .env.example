# =============================================================================
#  Ek Sathi Backend - Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git - it is listed in .gitignore.
# =============================================================================

# --- OpenRouter API Keys (LLM) -----------------------------------------------
# Add up to 11 keys. The service rotates through them round-robin to spread load.
OPENROUTER_API_KEY1=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_API_KEY2=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_API_KEY3=
OPENROUTER_API_KEY4=
OPENROUTER_API_KEY5=

# Per-key role assignment (optional).
BOB_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
CENTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx2

# --- Model Configuration ------------------------------------------------------
WRITER_MODEL=google/gemini-2.5-flash-lite
REVIEW_MODEL=google/gemini-2.5-flash
AUDITOR_MODEL=google/gemini-2.5-flash
VISION_MODEL=google/gemini-2.5-flash-lite
CHEAP_MODEL=google/gemini-2.5-flash-lite

# --- Firebase Web App Configuration -----------------------------------------
FIREBASE_API_KEY="AIzaSyAMja23cRN_gP8Rz1jUYGJbAsBTwFRHIrg"
FIREBASE_AUTH_DOMAIN="ek-sathi.firebaseapp.com"
FIREBASE_PROJECT_ID="ek-sathi"
FIREBASE_STORAGE_BUCKET="ek-sathi.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="55873351297"
FIREBASE_APP_ID="1:55873351297:web:5b8c15ed5a635d633ce780"
FIREBASE_MEASUREMENT_ID="G-WLFX2WZHCH"

# --- Firebase Admin SDK (Cloud Firestore Backend) ---------------------------
# To enable real Firestore cloud sync, download serviceAccountKey.json from Project Settings > Service accounts
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Cloudinary Document & Media Storage (Dual-Mode) -------------------------
# Optional: If configured, uploaded resumes, PDFs, and generated files go to Cloudinary CDN.
# If omitted or left empty, files are safely saved locally/serverless temporary disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Supabase Database Integration (Dual-Mode) ------------------------------
# Optional: If configured, structured app records are synchronized with Supabase Postgres.
# If omitted or left empty, operations seamlessly use our unified local storage engine.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub Repo Self-Read ----------------------------------------------------
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- Generation Settings ------------------------------------------------------
TEMPERATURE=0.2
MAX_TOKENS=2500
MAX_TOKENS_PER_KEY=150000

# --- Access Control -----------------------------------------------------------
SHARED_ADMIN_ID=nikhil_master_workspace

# --- Server -------------------------------------------------------------------
PORT=3000
ALLOWED_ORIGIN=http://localhost:3000

# --- Live Data (weather / news / markets) --------------------------------------
DEFAULT_CITY=New Delhi
DEFAULT_LAT=
DEFAULT_LON=
